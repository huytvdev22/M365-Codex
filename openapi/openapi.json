{
  "openapi": "3.1.0",
  "info": {
    "title": "API công khai M365-Codex",
    "version": "0.4.0",
    "description": "Giao diện cổng cục bộ tương thích với OpenAI Responses / Chat Completions / Files / Uploads. Dự án không chính thức."
  },
  "servers": [{ "url": "/" }],
  "security": [{ "ApiKeyAuth": [] }, { "BearerAuth": [] }],
  "paths": {
    "/v1/models": {
      "get": {
        "summary": "Liệt kê các mô hình khả dụng",
        "responses": {
          "200": {
            "description": "Danh sách mô hình",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ModelList" } }
            }
          },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/responses": {
      "post": {
        "summary": "Tạo một Response (non-stream hoặc SSE stream)",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/CreateResponseRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "Trả về đối tượng Response ở dạng non-stream (bao gồm phát lại Idempotency-Key); khi stream=true là text/event-stream (không phát lại, chỉ chặn trùng khóa đồng thời)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Response" } },
              "text/event-stream": { "schema": { "type": "string" } }
            }
          },
          "409": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/Error" },
          "502": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/responses/{id}": {
      "get": {
        "summary": "Lấy lại một Response",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Đối tượng Response",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Response" } }
            }
          },
          "404": { "$ref": "#/components/responses/Error" }
        }
      },
      "delete": {
        "summary": "Xóa/hủy một Response",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Đã xóa" }, "404": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/responses/{id}/cancel": {
      "post": {
        "summary": "Hủy Response đang thực hiện",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Đang hủy" },
          "400": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/chat/completions": {
      "post": {
        "summary": "Cổng tương thích Chat Completions (tái sử dụng nhân Responses, không dựng logic suy luận thứ hai)",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/ChatCompletionRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "Trả về chat.completion ở dạng non-stream (bao gồm phát lại Idempotency-Key); khi stream=true là chat.completion.chunk dạng text/event-stream (không phát lại, chỉ chặn trùng khóa đồng thời)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ChatCompletionResponse" } },
              "text/event-stream": { "schema": { "type": "string" } }
            }
          },
          "409": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/Error" },
          "502": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/files": {
      "post": {
        "summary": "Tải lên tệp",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file"],
                "properties": {
                  "file": { "type": "string", "format": "binary" },
                  "purpose": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Đối tượng File đã tạo",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FileObject" } } }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "413": { "$ref": "#/components/responses/Error" }
        }
      },
      "get": {
        "summary": "Liệt kê các tệp thuộc API Key hiện tại",
        "parameters": [
          { "name": "purpose", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Danh sách tệp",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FileList" } } }
          }
        }
      }
    },
    "/v1/files/{id}": {
      "get": {
        "summary": "Lấy siêu dữ liệu của một tệp",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Đối tượng File",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FileObject" } } }
          },
          "404": { "$ref": "#/components/responses/Error" }
        }
      },
      "delete": {
        "summary": "Xóa tệp",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Đã xóa" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/files/{id}/content": {
      "get": {
        "summary": "Tải về nội dung gốc của tệp",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Dữ liệu byte gốc của tệp",
            "content": { "application/octet-stream": { "schema": { "type": "string", "format": "binary" } } }
          },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/uploads": {
      "post": {
        "summary": "Tạo một phiên tải lên theo phân đoạn",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["filename", "bytes"],
                "properties": {
                  "filename": { "type": "string" },
                  "purpose": { "type": "string" },
                  "bytes": { "type": "integer" },
                  "mime_type": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Đối tượng Upload đã tạo",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UploadObject" } } }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "413": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/uploads/{id}/parts": {
      "post": {
        "summary": "Tải lên một phân đoạn",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["data"],
                "properties": { "data": { "type": "string", "format": "binary" } }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Đối tượng Upload.Part đã tạo",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UploadPartObject" } } }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "413": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/uploads/{id}/complete": {
      "post": {
        "summary": "Hoàn tất tải lên theo phân đoạn, ghép thành File",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["part_ids"],
                "properties": { "part_ids": { "type": "array", "items": { "type": "string" } } }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Đối tượng Upload đã hoàn tất (chứa trường file)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UploadObject" } } }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/uploads/{id}/cancel": {
      "post": {
        "summary": "Hủy một phiên tải lên phân đoạn chưa hoàn tất",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Đối tượng Upload đã hủy",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UploadObject" } } }
          },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": { "type": "apiKey", "in": "header", "name": "X-API-Key" },
      "BearerAuth": { "type": "http", "scheme": "bearer" }
    },
    "responses": {
      "Error": {
        "description": "Cấu trúc phản hồi lỗi thống nhất",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorBody" } }
        }
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": false,
        "schema": { "type": "string" },
        "description": "Cùng API Key + endpoint + khóa này trả về cùng kết quả tạo (§18). Khi stream=true không phát lại (SSE không thể phát lại), nhưng vẫn chặn yêu cầu trùng khóa đồng thời (trả về 409). Cùng một khóa nhưng kèm body yêu cầu khác nhau sẽ trả về 409."
      }
    },
    "schemas": {
      "ErrorBody": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["type", "code", "message"],
            "properties": {
              "type": { "type": "string" },
              "code": { "type": "string" },
              "message": { "type": "string" },
              "param": { "type": ["string", "null"] },
              "request_id": { "type": ["string", "null"] }
            }
          }
        }
      },
      "ModelList": {
        "type": "object",
        "required": ["object", "data"],
        "properties": {
          "object": { "const": "list" },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "object", "owned_by"],
              "properties": {
                "id": { "type": "string" },
                "object": { "const": "model" },
                "owned_by": { "type": "string" }
              }
            }
          }
        }
      },
      "CreateResponseRequest": {
        "type": "object",
        "required": ["model", "input"],
        "properties": {
          "model": { "type": "string" },
          "input": {
            "oneOf": [{ "type": "string" }, { "type": "array" }]
          },
          "instructions": { "type": "string" },
          "stream": { "type": "boolean" },
          "tools": { "type": "array" },
          "tool_choice": {},
          "parallel_tool_calls": { "type": "boolean" },
          "previous_response_id": { "type": "string" },
          "metadata": { "type": "object", "additionalProperties": { "type": "string" } },
          "max_output_tokens": { "type": "integer" },
          "temperature": { "type": "number" },
          "reasoning": { "type": "object" }
        }
      },
      "UrlCitation": {
        "type": "object",
        "required": ["type", "url", "start_index", "end_index"],
        "properties": {
          "type": { "const": "url_citation" },
          "url": { "type": "string" },
          "title": { "type": ["string", "null"] },
          "start_index": { "type": "integer" },
          "end_index": { "type": "integer" }
        }
      },
      "OutputTextContent": {
        "type": "object",
        "required": ["type", "text", "annotations"],
        "properties": {
          "type": { "const": "output_text" },
          "text": { "type": "string" },
          "annotations": { "type": "array", "items": { "$ref": "#/components/schemas/UrlCitation" } }
        }
      },
      "MessageItem": {
        "type": "object",
        "required": ["id", "type", "role", "status", "content"],
        "properties": {
          "id": { "type": "string" },
          "type": { "const": "message" },
          "role": { "const": "assistant" },
          "status": { "type": "string", "enum": ["in_progress", "completed"] },
          "content": { "type": "array", "items": { "$ref": "#/components/schemas/OutputTextContent" } }
        }
      },
      "ReasoningItem": {
        "type": "object",
        "required": ["id", "type", "summary"],
        "properties": {
          "id": { "type": "string" },
          "type": { "const": "reasoning" },
          "summary": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "text"],
              "properties": { "type": { "const": "summary_text" }, "text": { "type": "string" } }
            }
          }
        }
      },
      "FunctionCallItem": {
        "type": "object",
        "required": ["id", "type", "call_id", "name", "arguments", "status"],
        "properties": {
          "id": { "type": "string" },
          "type": { "const": "function_call" },
          "call_id": { "type": "string" },
          "name": { "type": "string" },
          "arguments": { "type": "string" },
          "status": { "type": "string", "enum": ["in_progress", "completed"] }
        }
      },
      "Response": {
        "type": "object",
        "required": ["id", "object", "created_at", "status", "model", "output"],
        "properties": {
          "id": { "type": "string" },
          "object": { "const": "response" },
          "created_at": { "type": "integer" },
          "status": {
            "type": "string",
            "enum": ["queued", "in_progress", "completed", "incomplete", "failed", "cancelled"]
          },
          "model": { "type": "string" },
          "output": {
            "type": "array",
            "items": {
              "oneOf": [
                { "$ref": "#/components/schemas/ReasoningItem" },
                { "$ref": "#/components/schemas/MessageItem" },
                { "$ref": "#/components/schemas/FunctionCallItem" }
              ]
            }
          },
          "usage": { "type": ["object", "null"] },
          "metadata": { "type": ["object", "null"] },
          "previous_response_id": { "type": ["string", "null"] },
          "reasoning": { "type": ["object", "null"] },
          "max_output_tokens": { "type": ["integer", "null"] },
          "temperature": { "type": ["number", "null"] },
          "error": { "type": ["object", "null"] },
          "incomplete_details": { "type": ["object", "null"] }
        }
      },
      "FileObject": {
        "type": "object",
        "required": ["id", "object", "bytes", "created_at", "filename", "purpose", "status"],
        "properties": {
          "id": { "type": "string" },
          "object": { "const": "file" },
          "bytes": { "type": "integer" },
          "created_at": { "type": "integer" },
          "filename": { "type": "string" },
          "purpose": { "type": "string" },
          "status": { "type": "string", "enum": ["processed", "error"] },
          "status_details": { "type": ["string", "null"] },
          "expires_at": { "type": ["integer", "null"] }
        }
      },
      "FileList": {
        "type": "object",
        "required": ["object", "data"],
        "properties": {
          "object": { "const": "list" },
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/FileObject" } }
        }
      },
      "UploadObject": {
        "type": "object",
        "required": ["id", "object", "bytes", "created_at", "filename", "purpose", "status", "expires_at"],
        "properties": {
          "id": { "type": "string" },
          "object": { "const": "upload" },
          "bytes": { "type": "integer" },
          "created_at": { "type": "integer" },
          "filename": { "type": "string" },
          "purpose": { "type": "string" },
          "status": { "type": "string", "enum": ["pending", "completed", "cancelled", "expired"] },
          "expires_at": { "type": "integer" },
          "file": { "oneOf": [{ "$ref": "#/components/schemas/FileObject" }, { "type": "null" }] }
        }
      },
      "UploadPartObject": {
        "type": "object",
        "required": ["id", "object", "created_at", "upload_id"],
        "properties": {
          "id": { "type": "string" },
          "object": { "const": "upload.part" },
          "created_at": { "type": "integer" },
          "upload_id": { "type": "string" }
        }
      },
      "ChatMessage": {
        "type": "object",
        "required": ["role"],
        "properties": {
          "role": { "type": "string", "enum": ["system", "developer", "user", "assistant", "tool"] },
          "content": {},
          "tool_calls": { "type": "array" },
          "tool_call_id": { "type": "string" },
          "name": { "type": "string" }
        }
      },
      "ChatCompletionRequest": {
        "type": "object",
        "required": ["model", "messages"],
        "properties": {
          "model": { "type": "string" },
          "messages": { "type": "array", "items": { "$ref": "#/components/schemas/ChatMessage" } },
          "stream": { "type": "boolean" },
          "temperature": { "type": "number" },
          "max_tokens": { "type": "integer" },
          "tools": { "type": "array" },
          "tool_choice": {},
          "parallel_tool_calls": { "type": "boolean" },
          "reasoning_effort": { "type": "string" }
        }
      },
      "ChatCompletionResponse": {
        "type": "object",
        "required": ["id", "object", "created", "model", "choices"],
        "properties": {
          "id": { "type": "string" },
          "object": { "const": "chat.completion" },
          "created": { "type": "integer" },
          "model": { "type": "string" },
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["index", "message", "finish_reason"],
              "properties": {
                "index": { "type": "integer" },
                "message": {
                  "type": "object",
                  "required": ["role"],
                  "properties": {
                    "role": { "const": "assistant" },
                    "content": { "type": ["string", "null"] },
                    "tool_calls": { "type": "array" }
                  }
                },
                "finish_reason": { "type": ["string", "null"] }
              }
            }
          },
          "usage": { "type": ["object", "null"] }
        }
      }
    }
  }
}
