# Sao chép thành .env.local và chỉnh sửa theo nhu cầu (.env* đã được bỏ qua trong .gitignore, chỉ có .env.example được lưu vào kho).

# Đặt thành 1 khi muốn chuyển toàn bộ trang sang dữ liệu giả lập từ src/api/mock.ts để phát triển giao diện độc lập.
VITE_USE_MOCK=0

# Mục tiêu proxy phát triển: vite.config.ts sẽ chuyển tiếp /admin, /v1 về đây, mặc định là cổng server.
VITE_API_TARGET=http://127.0.0.1:8080
