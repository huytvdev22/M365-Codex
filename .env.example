# ============================================================
# Cấu hình biến môi trường M365-Codex (Mẫu)
# Sao chép thành .env rồi điền thông tin. Kho lưu trữ 【CHỈ CHO PHÉP】 commit file .env.example này.
# Nghiêm cấm ghi bất kỳ Token / mật khẩu / thông tin tài khoản thật nào vào kho mã nguồn hoặc image container.
# ============================================================

# --- BẮT BUỘC ---

# Khóa mã hóa chính (Master Key): Mã hóa Base64, sau khi giải mã phải đúng 32 byte (AES-256-GCM).
# Không có giá trị mặc định; nếu thiếu hoặc sai định dạng dịch vụ sẽ từ chối khởi động (không vào trạng thái ready).
# Cách tạo: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
M365_CODEX_MASTER_KEY=

# Mật khẩu đăng nhập trang quản trị (tối thiểu 12 ký tự, khuyến nghị dùng chuỗi ngẫu nhiên từ trình quản lý mật khẩu).
M365_CODEX_ADMIN_PASSWORD=

# --- TÙY CHỌN ---

# Cổng lắng nghe dịch vụ, mặc định 8080
PORT=8080

# Thư mục dữ liệu (SQLite, tệp tải lên), mặc định /data; môi trường phát triển cục bộ có thể đặt ./data
DATA_DIR=/data

# URL Base API công khai, dùng cho giao diện quản trị sinh file config.toml cho Codex
PUBLIC_API_BASE_URL=

# Địa chỉ công khai của trang quản trị
PUBLIC_ADMIN_URL=

# Có tin cậy các header X-Forwarded-* từ reverse proxy hay không (true/false), mặc định false
TRUST_PROXY=false

# Chế độ bảo mật nhật ký (log privacy mode): strict (mặc định, nghiêm ngặt nhất) / metadata / debug
LOG_PRIVACY_MODE=strict
# Thời gian tự động hết hạn của chế độ debug (mili-giây), mặc định 3600000 (1 giờ): khi chuyển sang debug
# sẽ tự động tính thời gian hết hạn theo giá trị này, khi hết hạn sẽ tự động phục hồi về strict và ghi audit log;
# Giá trị an toàn thận trọng — debug sẽ ghi lại nhiều thông tin yêu cầu hơn, không nên duy trì vô thời hạn ở mức này
LOG_PRIVACY_DEBUG_TTL_MS=3600000

# Mức ghi log: fatal/error/warn/info/debug/trace, mặc định info
LOG_LEVEL=info

# Địa chỉ WebSocket gốc Sydney/BizChat upstream (dùng để xử lý trường hợp endpoint upstream bị đổi, để trống sẽ dùng cấu hình mặc định tích hợp sẵn)
# Mặc định wss://substrate.office.com
UPSTREAM_WS_BASE=

# Template đường dẫn kết nối upstream, {oid}/{tid} sẽ được thay thế bằng Object ID và Tenant ID của tài khoản
# Mặc định /m365Copilot/Chathub/{oid}@{tid}
UPSTREAM_PATH_TEMPLATE=
# Header X-Scenario bắt buộc phải có khi bắt tay WebSocket, đã được xác nhận thực tế với tài khoản thật ngày 27-07-2026
# Điều kiện bắt buộc để upstream chấp thuận: giá trị không đúng (bizchat/M365Chat v.v.) đều bị 403, trông giống hệt như
# tài khoản không có quyền. Mặc định officeweb; nếu upstream thay đổi giá trị này, chỉ cần chỉnh sửa tại đây
UPSTREAM_SCENARIO=
# Phiên bản tầng adapter giao thức. Mặc định sydney-json-v1, đã hiệu chuẩn với tài khoản thật ngày 27-07-2026
# (xem mục M0 trong docs/tien-do-milestone.md và chú thích đầu file src/adapter/codecV1.ts);
# Khi giao thức upstream thay đổi sang phiên bản mới thì chuyển đổi bằng biến này
UPSTREAM_PROTOCOL_VERSION=
# Khoảng thời gian heartbeat / timeout bắt tay / timeout rảnh rỗi (mili-giây) và số lần kết nối lại tối đa (trong cùng tài khoản)
UPSTREAM_HEARTBEAT_INTERVAL_MS=15000
UPSTREAM_HANDSHAKE_TIMEOUT_MS=15000
UPSTREAM_IDLE_TIMEOUT_MS=60000
UPSTREAM_MAX_RECONNECTS=2

# --- GỌI CÔNG CỤ VÀ VÒNG LẶP AGENT (TÙY CHỌN) ---
# Cách thức chuyển danh mục công cụ cho upstream:
#   native —— chỉ gửi khai báo công cụ có cấu trúc trong yêu cầu upstream
#   prompt —— chỉ dùng prompt để ràng buộc upstream xuất <tool_call>{…}</tool_call>
#   auto   —— áp dụng cả hai và đồng thời phân tích cả hai dạng (mặc định; an toàn nhất trước khi probe M0 xác nhận năng lực upstream)
TOOLS_MODE=auto
# Số lệnh gọi công cụ tối đa được chấp nhận trong một vòng, vượt quá sẽ báo lỗi rõ ràng, không tự ý cắt ngắn
TOOLS_MAX_CALLS_PER_ROUND=8
# Số vòng công cụ tối đa và tổng số lệnh gọi công cụ tích lũy trên một chuỗi hội thoại
TOOLS_MAX_ROUNDS=16
TOOLS_MAX_TOTAL_CALLS=64
# Kích thước byte tối đa cho kết quả của một công cụ, vượt quá trả về 413
TOOLS_MAX_RESULT_BYTES=262144
# Số lần yêu cầu upstream sửa lại khi tham số không hợp lệ, 0-2 (giới hạn trần theo quy tắc giao thức là 2)
TOOLS_MAX_ARG_REPAIRS=2
# Có cho phép xuất hiện nhiều lệnh gọi công cụ trong một vòng hay không (parallel_tool_calls trong yêu cầu chỉ có thể nghiêm ngặt hơn)
TOOLS_ALLOW_PARALLEL=true

# --- TỆP / HÌNH ẢNH / OFFICE-PDF (M6, TÙY CHỌN) ---
# Kích thước byte tối đa cho một tệp đơn (bao gồm một phân đoạn Upload đơn), mặc định 26214400 (25 MiB)
FILES_MAX_FILE_BYTES=26214400
# Kích thước byte tối đa cho một yêu cầu multipart đơn, phải ≥ FILES_MAX_FILE_BYTES, mặc định 27262976 (26 MiB)
FILES_MAX_REQUEST_BYTES=27262976
# Giới hạn dung lượng lưu trữ tích lũy cho một API Key, mặc định 209715200 (200 MiB)
FILES_MAX_TOTAL_BYTES_PER_KEY=209715200
# Thời gian lưu giữ tệp (mili-giây), quá hạn sẽ được tác vụ dọn dẹp thu hồi; mặc định 30 ngày, 0 nghĩa là không tự động hết hạn
FILES_RETENTION_MS=2592000000
# Thời gian tồn tại của Upload chưa hoàn tất (mili-giây), quá hạn coi như hết hạn và dọn dẹp các phân đoạn đã nhận, mặc định 24 giờ
FILES_UPLOAD_TTL_MS=86400000

# Upstream có thực sự hỗ trợ đầu vào hình ảnh (input_image) hay không. Mặc định false — năng lực thực tế phải đợi probe M0 hiệu chuẩn,
# khi là false thì input_image trả về lỗi unsupported_feature rõ ràng, không giả vờ hỗ trợ
UPSTREAM_IMAGE_INPUT=false

# Ngữ cảnh hội thoại tái tạo vượt quá bao nhiêu ký tự thì bắt đầu cắt ngắn từ lịch sử cũ nhất (các client store:false như Codex
# mỗi vòng sẽ gửi kèm hàng chục nghìn ký tự chỉ thị hệ thống + toàn bộ lịch sử). Mặc định 400000, một giá trị rộng rãi
CONTEXT_MAX_CHARS=400000

# Giá trị mặc định cho proxy gửi đi (có hiệu lực với kết nối WebSocket upstream và yêu cầu OAuth)
HTTP_PROXY=
HTTPS_PROXY=
# Danh sách host không đi qua proxy, phân tách bằng dấu phẩy hoặc dấu cách. Hỗ trợ domain trần (khớp cả chính nó và subdomain,
# ví dụ example.com sẽ khớp sub.example.com, nhưng không ảnh hưởng notexample.com),
# tiền tố dấu chấm/*. wildcard subdomain, IP, localhost; có thể kèm cổng (bỏ qua cổng khi so sánh);
# Dấu * đơn lẻ biểu thị tất cả host đều không đi qua proxy. Không phân biệt chữ hoa/thường.
NO_PROXY=

# Phiên bản khóa chính, dùng cho việc xoay vòng khóa (key rotation), mặc định 1
MASTER_KEY_VERSION=1

# --- THAM SỐ UPSTREAM OAUTH (TÙY CHỌN, ĐỂ TRỐNG DÙNG MẶC ĐỊNH TÍCH HỢP) ---
# Endpoint upstream có thể thay đổi, tất cả đều được cấu hình tại đây, không hardcode trong mã nguồn.

# Client ID công khai (luồng PKCE, không phải thông tin mật)
OAUTH_CLIENT_ID=
# Địa chỉ callback. Mặc định dùng trang nativeclient của Microsoft,
# nhờ đó dịch vụ này không cần public ra internet — người dùng sau khi đăng nhập dán callback URL trở lại giao diện quản trị
OAUTH_REDIRECT_URI=
OAUTH_AUTHORIZE_URL=
OAUTH_TOKEN_URL=
# Phân tách bằng dấu cách hoặc dấu phẩy. Mặc định:
#   https://substrate.office.com/sydney/M365Chat.Read
#   https://substrate.office.com/sydney/sydney.readwrite
#   offline_access openid profile
OAUTH_SCOPES=

# --- TRẦN TOÀN CỤC CHO HẠN NGẠCH API KEY (M7, §10) ---
# rpm_limit/daily_limit/max_concurrency của từng API Key chỉ có thể nghiêm ngặt hơn ở đây,
# tuyệt đối không được phép vượt qua — Key không thiết lập sẽ dùng giá trị tại đây làm mặc định dự phòng.

# Giới hạn số yêu cầu mỗi phút toàn cục, mặc định 600
RATE_LIMIT_GLOBAL_RPM=600
# Giới hạn số yêu cầu mỗi ngày toàn cục, mặc định 50000
RATE_LIMIT_GLOBAL_DAILY=50000
# Số yêu cầu đồng thời tối đa toàn cục, mặc định 50 (đếm trong tiến trình, tiền đề một container)
RATE_LIMIT_GLOBAL_MAX_CONCURRENCY=50

# --- DỌN DẸP ĐỊNH KỲ (M7, §18) ---

# Khoảng thời gian chạy dùng chung cho các tác vụ dọn dẹp (mili-giây), mặc định 600000 (10 phút)
CLEANUP_INTERVAL_MS=600000
# Response đã kết thúc (completed/failed/cancelled/incomplete) được giữ lại trong bao lâu (mili-giây), mặc định 7 ngày
CLEANUP_RESPONSE_RETENTION_MS=604800000
# Nhật ký kiểm toán (audit log) được giữ lại trong bao lâu (mili-giây), mặc định 90 ngày
CLEANUP_AUDIT_LOG_RETENTION_MS=7776000000
# Bản ghi idempotent (Idempotency-Key) được giữ lại trong bao lâu (mili-giây), mặc định 24 giờ
CLEANUP_IDEMPOTENCY_RETENTION_MS=86400000

# Timeout kiểm tra sức khỏe proxy gửi đi (mili-giây), mặc định 5000
PROXY_CHECK_TIMEOUT_MS=5000

# --- METRICS VÀ SAO LƯU (M8, §17, §15.4) ---

# Có bật endpoint GET /metrics (định dạng văn bản Prometheus) hay không, mặc định bật
METRICS_ENABLED=true
# /metrics có yêu cầu xác thực phiên quản trị hay không, mặc định bật — metrics để lộ số lượng tài khoản và phân bố lỗi,
# không nên mở công khai khi chưa xác thực; chỉ tắt khi xác nhận bộ thu thập dữ liệu (scraper) cùng nằm trong mạng nội bộ tin cậy
METRICS_REQUIRE_AUTH=true
# Số lượng gói sao lưu giữ lại: khi số gói do POST /admin/backup tạo ra vượt quá số này,
# tác vụ dọn dẹp định kỳ sẽ xóa gói cũ nhất, mặc định 7
BACKUP_RETENTION_COUNT=7

# ============================================================
# 【MỤC BỊ CẤM】 Không đưa bất kỳ Microsoft Token hoặc thông tin xác thực OAuth nào qua biến môi trường.
# Các thông tin xác thực này chỉ được lấy qua luồng ủy quyền PKCE và lưu trữ mã hóa AES-256-GCM trong database.
# Khi khởi động, dịch vụ sẽ kiểm tra và từ chối các biến môi trường sau (danh sách ví dụ, chưa đầy đủ):
#   M365_ACCESS_TOKEN / M365_REFRESH_TOKEN
#   MICROSOFT_ACCESS_TOKEN / MICROSOFT_REFRESH_TOKEN
#   SUBSTRATE_ACCESS_TOKEN / SYDNEY_ACCESS_TOKEN / COPILOT_ACCESS_TOKEN
# ============================================================
